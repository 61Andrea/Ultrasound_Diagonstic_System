    <property name="styleSheet">
     <string notr="true">/* 1. 默认状态：和谐的蓝底白字与白框 */
QPushButton {
    background-color: #1A6B9C;
    border: 2px solid #ffffff;
    border-radius: 4px;
    color: #ffffff;
    padding: 4px;
}

/* 2. 鼠标悬停状态：颜色稍微提亮 */
QPushButton:hover {
    background-color: #2284BF;
    border: 2px solid #ffffff;
}

/* 3. 按下状态：白底蓝字反色，保留下沉物理位移 */
QPushButton:pressed {
    background-color: #ffffff; 
    color: #165A82; 
    border: 2px solid #ffffff;
    
    padding-top: 6px;    
    padding-left: 6px;   
    padding-bottom: 2px;
    padding-right: 2px;
}</string>
    </property>
    <property name="text">
     <string>齿轮箱漏油
异常检测</string>
    </property>
   </widget>
