   <property name="styleSheet">
    <string notr="true">/* 底部居中的“信号监测功能”入口：黑色粗描边空心样式 */
QPushButton {
    background-color: transparent;
    border: 4px solid #000000;
    border-radius: 6px;
    color: #000000;
    font-weight: 900;
    padding: 4px;
}

/* 鼠标悬停：轻微加深底色，边框与文字不变 */
QPushButton:hover {
    background-color: rgba(0, 0, 0, 30);
    border: 4px solid #000000;
    color: #000000;
}

/* 按下：黑底白字反色，保留物理下沉感 */
QPushButton:pressed {
    background-color: #000000;
    color: #ffffff;
    border: 4px solid #000000;

    padding-top: 6px;
    padding-left: 6px;
    padding-bottom: 2px;
    padding-right: 2px;
}</string>
   </property>
   <property name="text">
    <string>信号监测功能</string>
   </property>
