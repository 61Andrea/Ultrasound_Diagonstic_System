   <string notr="true">
/* ================= 全局基础样式 ================= */
QWidget#B_window { background-color: #0b1426; }

QLabel#label_title {
    color: #00e5ff;
    background-color: transparent;
    letter-spacing: 2px;
}

/* ================= 选项卡样式 ================= */
QTabWidget::pane {
    border: 1px solid #1e3a5f;
    background-color: #111d35;
    border-radius: 4px;
}

QTabBar::tab {
    background: #142542;
    color: #7b90ad;
    padding: 10px 25px;
    margin-right: 4px;
    border: 1px solid #1e3a5f;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 120px;
    font-size: 11pt; /* 调整后的字体大小 */
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #111d35;
    color: #00e5ff;
    border-top: 3px solid #00e5ff;
}

QTabBar::tab:hover:!selected {
    background: #1a3359;
    color: #ffffff;
}

QWidget#tab_realtime_4, QWidget#tab_records_4, QWidget#tab_diagnosis {
    background-color: #111d35;
}

/* ================= 左侧功能按钮样式 ================= */
QPushButton {
    background-color: #142542;
    color: #00e5ff;
    border: 1px solid #1e3a5f;
    border-radius: 4px;
    padding: 12px;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover { background-color: #1a3359; border: 1px solid #00e5ff; }
QPushButton:pressed { background-color: #00e5ff; color: #0b1426; }

/* ================= 右侧显示大屏样式 (仅保留前两页的) ================= */
QFrame#frame_display_4, QFrame#frame_display_records_4 {
    background-color: #050a14;
    border: 2px solid #1e3a5f;
    border-radius: 6px;
}

/* ================= 第三页：智能诊断专项样式 ================= */
/* 大圆盘底座 */
QFrame#frame_dial {
    background-color: #050a14;
    border: 4px solid #1e3a5f;
    border-radius: 80px; /* 宽度160的一半，形成完美的圆 */
}

/* 状态小显示屏 (窄矩形) */
QLabel#label_diag_status {
    background-color: #050a14;
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    color: #3b5070; /* 暗暗的初始颜色 */
}
